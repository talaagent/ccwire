#!/usr/bin/env bash
# Re-fetches Claude Code's settings JSON schema into claude-code-settings and
# records the date (schema/README.md, SCHEMA_FETCHED). Then run the crate's
# tests: `schema` lists every property and enum value the schema has that
# tests/fixtures/full.json (and so the types) lack. Note the README's
# compatibility table too.
set -euo pipefail

url=https://json.schemastore.org/claude-code-settings.json
dir=$(dirname "$0")/../crates/claude-code-settings/schema
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
curl -sSfL "$url" -o "$tmp"
python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$tmp"
mv "$tmp" "$dir/claude-code-settings.json"
trap - EXIT
today=$(date -u +%Y-%m-%d)
sed -i "s/^Fetched: .*/Fetched: $today/" "$dir/README.md"
sed -i "s/^pub const SCHEMA_FETCHED: &str = \".*\";/pub const SCHEMA_FETCHED: \&str = \"$today\";/" "$dir/../src/lib.rs"
git diff --stat -- "$dir"
