        "source": "file",
        "path": "/opt/plugins/marketplace.json"
      }
    },
    "m-directory": {
      "source": {
        "source": "directory",
        "path": "/opt/plugins"
      }
    },
    "team-inline": {
      "source": {
        "source": "settings",
        "name": "team-inline",
        "plugins": [
          {
            "name": "a",
            "source": {
              "source": "github",
              "repo": "example/a",
              "ref": "main",
              "sha": "0123456789abcdef0123456789abcdef01234567"
            }
          },
          {
            "name": "b",
            "source": {
              "source": "url",
              "url": "https://git.example.com/b.git",
