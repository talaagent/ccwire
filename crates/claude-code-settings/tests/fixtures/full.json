              "sha": "0123456789abcdef0123456789abcdef01234567"
            }
          },
          {
            "name": "c",
            "source": {
              "source": "git-subdir",
              "url": "https://git.example.com/mono.git",
              "path": "plugins/c",
              "ref": "main",
              "sha": "0123456789abcdef0123456789abcdef01234567"
            }
          },
          {
            "name": "d",
