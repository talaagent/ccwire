{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "false",
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "stable",
  "awsCredentialExport": "false",
  "awsAuthRefresh": "false",
  "claudeMdExcludes": [
    "**/other/CLAUDE.md"
  ],
  "cleanupPeriodDays": 30,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "includeCoAuthoredBy": false,
  "plansDirectory": "./plans",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Read",
      "WebFetch(domain:example.com)",
      "mcp__memory"
    ],
    "deny": [
      "Bash(rm:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "additionalDirectories": [
      "/tmp"
    ],
    "blockReadsOutsideWorkingDirectories": false,
    "blockWritesOutsideWorkingDirectories": false,
    "denyInsteadOfPrompting": true
  },
  "language": "english",
  "model": "sonnet",
  "availableModels": [
    "sonnet",
    "haiku"
  ],
  "modelOverrides": {
    "claude-sonnet-4-6": "claude-sonnet-4-6"
  },
  "effortLevel": "high",
  "fastMode": false,
  "fastModePerSessionOptIn": false,
  "feedbackSurveyRate": 0.05,
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "memory"
  ],
  "disabledMcpjsonServers": [
    "filesystem"
  ],
  "allowedMcpServers": [
    {
      "serverName": "memory"
    },
    {
      "serverCommand": [
        "npx",
        "-y",
        "@example/mcp"
      ]
    },
    {
      "serverUrl": "https://mcp.example.com/*"
    }
  ],
  "deniedMcpServers": [
    {
      "serverName": "filesystem"
    },
    {
      "serverCommand": [
        "false"
      ]
    },
    {
      "serverUrl": "https://evil.example.com/*"
    }
  ],
  "httpHookAllowedEnvVars": [
    "TOKEN"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "args": [
              "--flag"
            ],
            "timeout": 10,
            "async": false,
            "asyncRewake": false,
            "shell": "bash",
            "if": "Bash(git *)",
            "statusMessage": "checking",
            "onFailure": "continue"
          },
          {
            "type": "prompt",
            "prompt": "Check $ARGUMENTS",
            "model": "haiku",
            "timeout": 30,
            "if": "Bash(git *)",
            "statusMessage": "asking",
            "continueOnBlock": true
          },
          {
            "type": "agent",
            "prompt": "Verify $ARGUMENTS",
            "model": "haiku",
            "timeout": 60,
            "if": "Bash(git *)",
            "statusMessage": "verifying"
          },
          {
            "type": "http",
            "url": "http://localhost:8080/hook",
            "headers": {
              "Authorization": "Bearer $TOKEN"
            },
            "allowedEnvVars": [
              "TOKEN"
            ],
            "timeout": 5,
            "if": "Bash(git *)",
            "statusMessage": "posting",
            "onFailure": "block"
          },
          {
            "type": "mcp_tool",
            "server": "memory",
            "tool": "note",
            "input": {
              "path": "${tool_input.file_path}"
            },
            "timeout": 5,
            "if": "Bash(git *)",
            "statusMessage": "calling"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "true"
          }
        ]
      }
    ],
    "Notification": [
